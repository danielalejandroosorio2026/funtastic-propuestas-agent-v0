{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Propuesta Funtastic v2",
  "type": "object",
  "required": [
    "estado",
    "consulta_id",
    "confianza",
    "datos_faltantes",
    "paquete_recomendado",
    "alternativa",
    "cotizacion",
    "alertas",
    "mensaje_whatsapp",
    "resumen_interno",
    "requiere_revision_humana",
    "motivos_revision"
  ],
  "properties": {
    "estado": {
      "enum": [
        "BORRADOR",
        "REQUIERE_DATOS",
        "NO_COTIZABLE"
      ]
    },
    "consulta_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "confianza": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "datos_faltantes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paquete_recomendado": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "nombre",
            "justificacion"
          ],
          "properties": {
            "nombre": {
              "enum": [
                "Basica",
                "Completa",
                "Saludable"
              ]
            },
            "justificacion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "alternativa": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "nombre",
            "diferencia"
          ],
          "properties": {
            "nombre": {
              "enum": [
                "Basica",
                "Completa",
                "Saludable"
              ]
            },
            "diferencia": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "cotizacion": {
      "type": "object",
      "required": [
        "moneda",
        "catalogo_validado",
        "items",
        "total_estimado"
      ],
      "properties": {
        "moneda": {
          "const": "ARS"
        },
        "catalogo_validado": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "concepto",
              "cantidad",
              "precio_unitario",
              "subtotal",
              "fuente"
            ],
            "properties": {
              "concepto": {
                "type": "string"
              },
              "cantidad": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "precio_unitario": {
                "type": "number",
                "minimum": 0
              },
              "subtotal": {
                "type": "number",
                "minimum": 0
              },
              "fuente": {
                "enum": [
                  "datos/catalogo_paquetes.csv",
                  "datos/adicionales.csv"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "total_estimado": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "alertas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mensaje_whatsapp": {
      "type": "string",
      "maxLength": 1800
    },
    "resumen_interno": {
      "type": "object"
    },
    "requiere_revision_humana": {
      "const": true
    },
    "motivos_revision": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
